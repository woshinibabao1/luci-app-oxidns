msgid "%d step(s)"
msgstr "%d 个步骤"

msgid "A token is currently configured. Enter a new value to replace it."
msgstr "当前已配置 Token。输入新值可替换现有 Token。"

msgid "Add upstream DNS"
msgstr "添加上游DNS"

msgid "Adds a cache plugin and runs it before forwarding in the entry sequence. Cached responses answer repeated queries without contacting upstream servers."
msgstr "添加缓存插件，并在转发前运行。缓存响应可在不访问上游服务器的情况下应答重复查询。"

msgid "API"
msgstr "API"

msgid "Adds a forward plugin and runs it at the end of the entry sequence. Add at least one upstream DNS server below."
msgstr "添加 forward 插件，并在入口 sequence 末尾运行。请在下方至少添加一个上游 DNS 服务器。"

msgid "Adds a hosts plugin and runs it before forwarding in the entry sequence. Configured names are answered locally and everything else is forwarded."
msgstr "添加 hosts 插件，并在入口序列中先于转发运行。配置过的域名在本地应答，其余请求继续转发。"

msgid "Applying service action..."
msgstr "正在执行服务操作..."

